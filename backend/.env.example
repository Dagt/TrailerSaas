# Documentation only: Spring Boot does NOT load this file automatically.
# Export required variables securely to the backend process; see backend/README.md.
SPRING_PROFILES_ACTIVE=local
# Exact Web origin allowlist. Defaults are loopback-only in local; supply HTTPS origins outside local.
WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_RUNTIME_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/trailersaas
DB_RUNTIME_USERNAME=example_runtime
# Secret: replace locally, never commit the populated copy.
DB_RUNTIME_PASSWORD=<set-locally>
# Optional: same database as runtime, with separate migration credentials.
DB_MIGRATION_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/trailersaas
DB_MIGRATION_USERNAME=example_migration
# Secret:
DB_MIGRATION_PASSWORD=<set-locally>

# Firebase backend #22: project ID is required non-secret configuration.
FIREBASE_PROJECT_ID=<set-locally>
# ADC credential file path for local use; file contents are secret and must stay outside Git.
# Managed environments may instead provide official ambient Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=<set-locally>

# R2 #52: disabled explicitly for unconfigured local development/CI; APIs fail closed.
R2_ENABLED=false
DOCUMENT_MAX_SIZE_BYTES=26214400
DOCUMENT_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,application/pdf
DOCUMENT_UPLOAD_TTL_SECONDS=300
DOCUMENT_DOWNLOAD_TTL_SECONDS=60
# When enabled, all five values are required. Use a private environment-specific bucket.
# Account ID is the real 32-character account identifier, supplied outside Git.
# R2_ACCOUNT_ID=<set-locally>
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=example-development
# R2_ACCESS_KEY_ID=<set-locally>
# R2_SECRET_ACCESS_KEY=<set-locally>
# R2_PUBLIC_BASE_URL is deliberately NOT consumed for private documents.
# RESERVED ONLY below:
# Backend Sentry remains reserved: #21 uses logs/Micrometer/OTel, not Sentry Java.
# DSN is ingestion config, not an admin credential; do not expose backend config.
# SENTRY_ENVIRONMENT=development
# SENTRY_DSN=<set-locally>
# SENTRY_AUTH_TOKEN=<set-locally>
