# Public browser configuration only. Never put secrets in VITE_* variables.
VITE_APP_ENV=development
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Public Firebase Web Authentication #30. Supply all four to enable sign-in.
# Blank keeps the unconfigured build disabled; use your non-production project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional public QR URL base. Development can use loopback HTTP; no fallback page is implemented.
VITE_QR_PUBLIC_BASE_URL=
# FCM remains reserved for #56.
# VITE_FIREBASE_MESSAGING_SENDER_ID=<set-locally>
# VITE_FIREBASE_VAPID_KEY=<set-locally>
# Optional Sentry #21. Empty DSN disables the SDK; environment must match VITE_APP_ENV.
# Public ingestion config only, never SENTRY_AUTH_TOKEN in VITE_*.
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_DSN=
