# Public build-time config only. Copy to ignored .env.staging.local and replace URL.
# This host is deliberately an example, not a configured environment.
VITE_APP_ENV=staging
VITE_API_BASE_URL=https://api.staging.example.test/api/v1
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_DSN=
# Supply this environment's public Firebase Web project/app config together.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional absolute HTTPS base; missing disables QR printing.
VITE_QR_PUBLIC_BASE_URL=
