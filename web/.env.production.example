# Public build-time config only. Copy to ignored .env.production.local and replace URL.
# Explicit VITE_APP_ENV is required independently of Vite's production build mode.
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.production.example.test/api/v1
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_DSN=
# Supply this environment's public Firebase Web project/app config together.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional absolute HTTPS base; do not hard-code a real Production host.
VITE_QR_PUBLIC_BASE_URL=
